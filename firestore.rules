rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Suggestions: anyone can create (public form), only admins can read/update/delete
    match /suggestions/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Activity log: admins only
    match /activity_log/{id} {
      allow read, write: if isAdmin();
    }

    // Rate limit: server-side only (admin SDK) — no client access
    match /rate_limit/{ip} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'nathancwatkins23@gmail.com',
          'nastyn8plays@gmail.com'
        ];
    }
  }
}
