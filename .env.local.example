# ─── Firebase Client SDK (public — safe to expose) ───────────────────────────
# Get these from: Firebase Console → Project Settings → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin SDK (private — server-side only) ─────────────────────────
# Get these from: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# For the private key, paste the full key from the JSON file (including newlines as \n)
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── Email Notifications (optional) ──────────────────────────────────────────
# Use Gmail app password: myaccount.google.com/apppasswords
NOTIFY_EMAIL_TO=nastyn8plays@gmail.com
NOTIFY_EMAIL_FROM=nastyn8plays@gmail.com
NOTIFY_EMAIL_PASS=

# ─── Site URL (recommended for production) ───────────────────────────────────
# Sets the base URL used in Discord / email deep-links (e.g. "Review this submission").
# Without it the server falls back to X-Forwarded-Host → Host, which may expose
# an internal Cloud Run hostname on Firebase App Hosting.
# Example: https://suggestion-box.example.com
# Leave blank in local dev — localhost fallback works fine there.
SITE_URL=

# ─── Discord Outbound Webhook (optional) ─────────────────────────────────────
# Paste a Discord channel webhook URL to get an embed for every new submission.
# Leave blank to disable.
# NOTE: In local dev the deep-link in Discord will point to localhost:3000/:3001
# and only works if the dev server is running on the same machine.
DISCORD_WEBHOOK_URL=

# ─── Weekly Recap (optional) ─────────────────────────────────────────────────
# Bearer token that authorizes GET /api/weekly-recap (for cron jobs / CLI calls).
# Leave blank during dev — admin UI uses Firebase auth instead.
# v2.7: wire this into a Cloud Scheduler job for automatic weekly sends.
RECAP_SECRET=

# ─── Cloudflare Turnstile (bot protection — replaces reCAPTCHA) ───────────────
# 1. Create a free Cloudflare account, open Turnstile, add a widget for your
#    domain (and localhost for dev): https://dash.cloudflare.com/?to=/:account/turnstile
# 2. Copy the Site Key (public) and Secret Key (private) below.
# Turnstile works on ANY host — you do NOT need to host the app on Cloudflare.
# Verification is gated on TURNSTILE_SECRET_KEY: leave it blank to disable the check.
# For local dev you can use Cloudflare's always-pass test keys:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Turso / libSQL (database) ───────────────────────────────────────────────
# Local dev: leave as the file DB below (no Turso account needed).
# Production: create a free Turso DB and paste its URL + token.
#   npm i -g turso ; turso auth signup ; turso db create nasty-n8
#   turso db show nasty-n8 --url    -> TURSO_DATABASE_URL
#   turso db tokens create nasty-n8 -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# ─── Better Auth (magic-link admin login) ────────────────────────────────────
# Generate a secret: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public base URL of the app (http://localhost:3000 in dev; your domain in prod)
BETTER_AUTH_URL=http://localhost:3000
